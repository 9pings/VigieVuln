  "repository": {
    "type": "git",
    "url": "git+https://github.com/9pings/fad-checker.git"
  },
  "homepage": "https://github.com/9pings/fad-checker#readme",
  "bugs": "https://github.com/9pings/fad-checker/issues",
  "author": "pp9Ping <pp9Ping@gmail.com>",
  "maintainers": [
    "pp9Ping <pp9Ping@gmail.com>"
  ],
  "contributors": [
    "pp9Ping <pp9Ping@gmail.com>"
  ],
  "bin": {
    "fad-checker": "fad-checker.js",
    "fad": "fad-checker.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js packages/fad-service/test/*.test.js",
    "build:linux": "bun build fad-checker.js --compile --target=bun-linux-x64 --outfile=dist/fad-checker",
    "build:win": "bun build fad-checker.js --compile --target=bun-windows-x64 --outfile=dist/fad-checker.exe",
    "build:macos": "bun build fad-checker.js --compile --target=bun-darwin-x64 --outfile=dist/fad-checker-macos",
    "build": "npm run build:linux && npm run build:win"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "fflate": "^0.8.3",
    "js-yaml": "^4.3.2",
    "minimatch": "^10.2.6",
    "p-limit": "^3.1.0",
    "retire": "^5.7.0",
    "rimraf": "^6.1.3",
    "smol-toml": "^1.8.0",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
