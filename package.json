{
  "name": "vigievuln",
  "version": "1.4.0",
  "description": "Polyglot dependency auditor for Maven, Gradle, JavaScript, Composer, PyPI, NuGet, Go, Ruby and 11 CMS/frameworks, with offline scans and audit reports.",
  "keywords": [
    "sca",
    "software-composition-analysis",
    "dependency-scanner",
    "vulnerability-scanner",
    "security",
    "cve",
    "osv",
    "nvd",
    "epss",
    "kev",
    "cyclonedx",
    "sbom",
    "csaf",
    "vex",
    "sarif",
    "xlsx",
    "excel",
    "license-compliance",
    "eol",
    "end-of-life",
    "outdated",
    "deprecated",
    "audit",
    "devsecops",
    "appsec",
    "supply-chain",
    "offline",
    "air-gapped",
    "maven",
    "npm",
    "yarn",
    "pnpm",
    "composer",
    "pypi",
    "nuget",
    "go",
    "golang",
    "ruby",
    "rubygems",
    "retirejs",
    "polyglot",
    "cli",
    "cms",
    "framework",
    "wordpress",
    "drupal",
    "symfony",
    "laravel",
    "joomla",
    "prestashop",
    "typo3",
    "magento",
    "spip",
    "proxy-cache",
    "code-audit",
    "certificates",
    "binary-analysis"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9pings/VigieVuln.git"
  },
  "homepage": "https://github.com/9pings/VigieVuln#readme",
  "bugs": "https://github.com/9pings/VigieVuln/issues",
  "author": "pp9Ping <pp9Ping@gmail.com>",
  "maintainers": [
    "pp9Ping <pp9Ping@gmail.com>"
  ],
  "contributors": [
    "pp9Ping <pp9Ping@gmail.com>"
  ],
  "bin": {
    "vigievuln": "vigievuln.js",
    "fad-checker": "vigievuln.js",
    "fad": "vigievuln.js"
  },
  "exports": {
    ".": "./vigievuln.js",
    "./package.json": "./package.json",
    "./data/*": "./data/*",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./lib/advisory-compression": "./lib/cache/advisory-compression.js",
    "./lib/advisory-store": "./lib/advisories/store.js",
    "./lib/advisory-store-sqlite": "./lib/advisories/store-sqlite.js",
    "./lib/application-providers/live-snapshot": "./lib/applications/live-snapshot.js",
    "./lib/application-providers/wordfence-v3": "./lib/providers/wordfence/v3.js",
    "./lib/cache-archive-sqlite": "./lib/cache/archive.js",
    "./lib/cache-db": "./lib/cache/db.js",
    "./lib/cache-repository": "./lib/cache/repository.js",
    "./lib/certfr": "./lib/providers/certfr/enrich.js",
    "./lib/cve-download": "./lib/providers/cveproject/download.js",
    "./lib/cve-npm-proxy": "./lib/providers/cveproject/npm-proxy.js",
    "./lib/cve-version-verdict": "./lib/providers/cveproject/version-verdict.js",
    "./lib/deps-descriptor": "./lib/inventory/deps-descriptor.js",
    "./lib/dump-format": "./lib/cache/dump-format.js",
    "./lib/euvd": "./lib/providers/euvd/enrich.js",
    "./lib/gcve": "./lib/providers/gcve/id.js",
    "./lib/gcve-feed": "./lib/providers/gcve/feed.js",
    "./lib/gcve-index": "./lib/providers/gcve/local-index.js",
    "./lib/github-publisher-maven": "./lib/providers/github/publisher-maven.js",
    "./lib/kev": "./lib/providers/kev/enrich.js",
    "./lib/line-stream": "./lib/inventory/line-stream.js",
    "./lib/maven-airgap": "./lib/codecs/maven/airgap.js",
    "./lib/maven-version": "./lib/codecs/maven/version.js",
    "./lib/native-advisories": "./lib/advisories/native.js",
    "./lib/native-package-match": "./lib/advisories/native-package-match.js",
    "./lib/nvd": "./lib/providers/nvd/enrich.js",
    "./lib/nvd-bulk": "./lib/providers/nvd/bulk.js",
    "./lib/osv": "./lib/providers/osv/query.js",
    "./lib/osv-db": "./lib/providers/osv/db.js",
    "./lib/package-metadata": "./lib/inventory/package-metadata.js",
    "./lib/package-versions": "./lib/inventory/package-versions.js",
    "./lib/providers": "./lib/providers/index.js",
    "./lib/proxy-scope": "./lib/cache/proxy-scope.js",
    "./lib/resource-cache/engine": "./lib/cache/resource/engine.js",
    "./lib/resource-cache/fs-store": "./lib/cache/resource/fs-store.js",
    "./lib/resource-cache/validate": "./lib/cache/resource/validate.js",
    "./lib/source-health": "./lib/scan/source-health.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "build:linux": "bun build vigievuln.js --compile --target=bun-linux-x64 --outfile=dist/vigievuln",
    "build:linux:musl": "sh scripts/build-linux-musl.sh",
    "build:win": "bun build vigievuln.js --compile --target=bun-windows-x64 --outfile=dist/vigievuln.exe && node scripts/set-windows-icon.js dist/vigievuln.exe",
    "build:macos": "bun build vigievuln.js --compile --target=bun-darwin-x64 --outfile=dist/vigievuln-macos",
    "build": "npm run build:linux && npm run build:win",
    "pack:release": "node scripts/pack-release.js"
  },
  "dependencies": {
    "@renovatebot/pep440": "3.0.20",
    "7z-wasm": "1.2.0",
    "chalk": "^4.1.2",
    "commander": "^15.1.0",
    "domutils": "^3.2.2",
    "enquirer": "^2.4.1",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "htmlparser2": "^10.1.0",
    "js-yaml": "^4.3.2",
    "minimatch": "^11.0.4",
    "p-limit": "^3.1.0",
    "retire": "^6.1.0",
    "rimraf": "^6.1.4",
    "smol-toml": "^1.8.0",
    "stream-chain": "^2.2.5",
    "stream-json": "^1.9.1",
    "tar-stream": "^3.2.2",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": "^22.13.0 || ^23.4.0 || >=24.0.0"
  },
  "files": [
    "vigievuln.js",
    "fad-checker.js",
    "lib/",
    "data/",
    "completions/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "resedit": "^3.1.0"
  }
}
