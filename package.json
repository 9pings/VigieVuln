{
  "name": "fad-checker",
  "version": "2.7.4",
  "description": "One-shot polyglot dependency auditor (10 ecosystems + 9 CMS/Frameworks). No build tools. Real & complete air-gapped mode. Private deps, binaries, certs, EOL, CVE (KEV+EPSS) - Made for professional code audits.",
  "keywords": [
    "sca",
    "software-composition-analysis",
    "dependency-scanner",
    "vulnerability-scanner",
