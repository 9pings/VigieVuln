      "--output-file",
      "<report>",
      "<project>"
    ],
    "trivy": [
      "trivy",
      "fs",
      "--cache-dir",
      "/work/trivy-cache",
      "--skip-db-update",
      "--skip-java-db-update",
      "--scanners",
      "vuln",
      "--format",
      "json",
      "--output",
      "<report>",
      "<project>"
    ],
    "grype": [
      "grype",
      "dir:<project>",
      "-o",
      "json",
      "--file",
      "<report>"
    ]
  },
  "environment": {
    "trivy": {
      "MAVEN_HOME": "/work/maven-home",
      "trustStore": "Host /etc/ssl/certs mounted read-only, TLS verification enabled",
      "mavenMirror": "https://maven-central.storage-download.googleapis.com/maven2"
    },
    "grype": {
      "GRYPE_DB_CACHE_DIR": "/work/grype-db",
      "GRYPE_DB_AUTO_UPDATE": "false",
      "GRYPE_CHECK_FOR_APP_UPDATE": "false"
    }
  },
  "excludedRuns": [
    "Trivy runs without the Maven mirror / host trust store produced incomplete inventories; debug logs showed HTTPS trust failures. Their reports are excluded from the final comparison."
