# /etc/systemd/system/fad-service.service — the web instances (public site + /v1/resource).
# Install: useradd --system --home /var/lib/fad-service fad-service
#          install -d -o fad-service /var/lib/fad-service /var/log/fad-service
#          install -m 0640 config.json /etc/fad-service/config.json ; secrets in /etc/fad-service/env
[Unit]
Description=fad-service web
Documentation=https://github.com/9pings/fad-checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fad-service
Group=fad-service
EnvironmentFile=-/etc/fad-service/env
Environment=NODE_ENV=production NODE_NO_WARNINGS=1
ExecStart=/usr/bin/node /opt/fad-service/packages/fad-service/bin/fad-service.js serve --config /etc/fad-service/config.json
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=35
Restart=on-failure
RestartSec=5

StateDirectory=fad-service
LogsDirectory=fad-service
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/fad-service /var/log/fad-service
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
