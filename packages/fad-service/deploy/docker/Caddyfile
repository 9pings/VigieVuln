# TLS is automatic (Let's Encrypt / ZeroSSL). Caddy appends the client address to
# X-Forwarded-For, which fad-service reads with --trust-proxy (last entry only).
{$FAD_DOMAIN} {
	encode zstd gzip

	# Never expose the metrics port or the admin API publicly.
	@admin path /admin/*
	respond @admin 404

	reverse_proxy web:8322 {
		lb_policy least_conn
		health_uri /health
		health_interval 10s
		fail_duration 30s
	}

	# Same privacy rule as the service's own log: no search text, no credentials, no full
	# address (IPv4 /16, IPv6 /32 kept — enough for abuse triage, not to identify a reader).
	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format filter {
			request>uri query {
				delete q
			}
			request>headers>Authorization delete
			request>headers>X-Fad-Proxy-Token delete
			request>headers>Cookie delete
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
		}
	}
}
