# Copy to .env (never commit it). Secrets are read from the environment only.
FAD_DOMAIN=vuln.example.fr
FAD_SERVICE_GITHUB_TOKEN=
FAD_SERVICE_NVD_KEY=
# REQUIRED: the web containers expose /metrics on the docker network (port 9464) and refuse
# to start without it. Generate with: openssl rand -hex 32
FAD_SERVICE_METRICS_TOKEN=
# Memory limits (optional): FAD_WEB_MEM=1536m FAD_WORKER_MEM=2g
