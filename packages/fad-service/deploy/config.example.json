{
	"db": "/var/lib/fad-service/fad-service.db",
	"listen": { "host": "127.0.0.1", "port": 8322 },
	"workers": 4,
	"region": "fr",
	"trustProxy": true,
	"rateLimit": { "client": 600, "public": 300 },
	"cacheSeconds": 300,
	"shutdownSeconds": 25,
	"log": { "file": "/var/log/fad-service/fad-service.log", "format": "json", "level": "info", "maxSize": "50M", "keep": 10, "access": true },
	"brand": {
		"name": "Vulnérabilités · Exemple",
		"tagline": "Données de vulnérabilités hébergées en France.",
		"baseUrl": "https://vuln.example.fr",
		"logo": "/etc/fad-service/logo.svg",
		"accent": "#1f4fd1",
		"footer": "Un service Exemple",
		"contact": "mailto:securite@example.fr",
		"publisher": { "name": "Exemple SAS", "address": "1 rue de l'Exemple, 75000 Paris", "director": "Jeanne Exemple", "contact": "mailto:contact@example.fr" },
		"host": { "name": "Hébergeur SAS", "address": "2 rue de l'Hébergeur, 59100 Roubaix", "contact": "https://hebergeur.example" }
	},
	"metrics": { "enabled": true, "listen": "127.0.0.1:9464" },
	"analytics": { "provider": "server" },
	"jobs": { "enabled": null, "everyMinutes": 10, "osvEcosystems": null }
}
