# /etc/logrotate.d/fad-service — only if you prefer logrotate to the built-in rotation
# (set log.maxSize to a large value then). SIGHUP makes fad-service reopen its log file.
/var/log/fad-service/*.log {
	daily
	rotate 14
	compress
	delaycompress
	missingok
	notifempty
	create 0640 fad-service fad-service
	sharedscripts
	postrotate
		systemctl kill --signal=HUP fad-service.service fad-service-worker.service >/dev/null 2>&1 || true
	endscript
}
